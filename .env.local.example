# ============================================================
# FIT MOM 20 — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in YOUR values.
# NEVER commit .env.local to Git.
# ============================================================

# --- Firebase (get these from Firebase Console → Project Settings) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- Stripe (get these from Stripe Dashboard → Developers → API Keys) ---
# Use TEST keys only! They start with pk_test_ and sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# --- Stripe Price ID ---
# Create a product in Stripe Dashboard → Products → Add Product
# Set price to ₹499/month, then copy the Price ID (starts with price_)
STRIPE_PRICE_ID=price_your_price_id_here
